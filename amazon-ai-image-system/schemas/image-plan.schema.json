{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amazon-image-system.local/schemas/image-plan.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "image_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "type": {
            "enum": [
              "main",
              "secondary",
              "aplus",
              "lifestyle",
              "feature",
              "size",
              "detail",
              "comparison",
              "scene"
            ]
          },
          "buyer_question": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "visible_copy": {
            "type": "string"
          },
          "composition": {
            "type": "string",
            "minLength": 1
          },
          "scene": {
            "type": "string",
            "minLength": 1
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "image_id",
          "type",
          "buyer_question",
          "evidence",
          "message",
          "visible_copy",
          "composition",
          "scene",
          "constraints",
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "images"
  ],
  "additionalProperties": false
}
