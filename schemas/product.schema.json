{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amazon-image-system.local/schemas/product.schema.json",
  "type": "object",
  "properties": {
    "product_identity": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "string",
                "object",
                "null"
              ]
            }
          }
        }
      ]
    },
    "structure": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "string",
                "array",
                "object",
                "null"
              ]
            }
          }
        }
      ]
    },
    "material": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "string",
                "array",
                "object",
                "null"
              ]
            }
          }
        }
      ]
    },
    "color": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "string",
                "array",
                "object",
                "null"
              ]
            }
          }
        }
      ]
    },
    "quantity": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      ]
    },
    "dimensions": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "string",
                "array",
                "object",
                "null"
              ]
            }
          }
        }
      ]
    },
    "accessories": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "supported_claims": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "immutable_features": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "forbidden_changes": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "reference_images": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "product_identity",
    "structure",
    "material",
    "color",
    "quantity",
    "dimensions",
    "accessories",
    "supported_claims",
    "immutable_features",
    "forbidden_changes",
    "reference_images"
  ],
  "additionalProperties": false,
  "$defs": {
    "fact": {
      "type": "object",
      "properties": {
        "value": {},
        "status": {
          "enum": [
            "CONFIRMED",
            "INFERRED",
            "MISSING",
            "CONFLICT",
            "LOCKED"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "status",
        "sources",
        "note"
      ],
      "additionalProperties": false
    }
  }
}
